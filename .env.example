# 公众号服务端凭证，只放在后端环境变量，不要写入小程序代码
WECHAT_OFFICIAL_APPID=
WECHAT_OFFICIAL_APPSECRET=

# 可选：同步数据目录
WECHAT_SYNC_DATA_DIR=./data
WECHAT_SYNC_PAGE_SIZE=20
WECHAT_SYNC_MAX_PAGES=100

# CloudBase 配置
CLOUDBASE_ENV_ID=
# PostgreSQL 环境使用云存储保存 JSON，不需要文档型数据库集合
CLOUDBASE_STORAGE_PREFIX=xianhua-content
CLOUDBASE_SERVICE_NAME=
PORT=8080  # 云托管监听端口

# 内容 API（不包含公众号凭证）
CONTENT_API_HOST=127.0.0.1
CONTENT_API_PORT=8787

# 远程触发同步的令牌（POST /api/sync 时请求头 x-sync-token 必须匹配；留空则禁止远程触发）
SYNC_TRIGGER_TOKEN=

# 可选：文章正文 -> 门店结构化模型服务（OpenAI 兼容接口）
CONTENT_STRUCTURER_URL=
CONTENT_STRUCTURER_API_KEY=
CONTENT_STRUCTURER_MODEL=
